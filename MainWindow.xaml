<Window x:Class="NotchWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchWin"
        Icon="pack://application:,,,/Assets/NotchWin.ico"
        Width="760" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Fg}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Theme colours: replaced at runtime by the selected theme (see Themes.cs) -->
        <SolidColorBrush x:Key="NotchBg" Color="#FF050505" />
        <SolidColorBrush x:Key="NotchBorder" Color="Transparent" />
        <SolidColorBrush x:Key="Fg" Color="White" />
        <SolidColorBrush x:Key="FgSoft" Color="#C0FFFFFF" />
        <SolidColorBrush x:Key="FgDim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="FgFaint" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="Track" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="ButtonBg" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="ButtonHover" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ButtonPress" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="TileBg" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TileHover" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Eq" Color="#FF3DDC84" />

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgDim}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- Round media buttons -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shortcut tiles -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource TileBg}" />
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPress}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Soft shadow under the notch -->
        <Border x:Name="Shadow" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Black"
                Width="{Binding ActualWidth, ElementName=Pill}" Height="{Binding ActualHeight, ElementName=Pill}"
                CornerRadius="{Binding CornerRadius, ElementName=Pill}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- The notch itself -->
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="210" Height="34" Background="{DynamicResource NotchBg}" BorderBrush="{DynamicResource NotchBorder}" CornerRadius="0,0,17,17"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                MouseLeftButtonDown="Pill_MouseDown" MouseMove="Pill_MouseMove" MouseLeftButtonUp="Pill_MouseUp">
            <Grid ClipToBounds="True">

                <!-- ========== COMPACT ========== -->
                <Grid x:Name="CompactView" Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="CompactIcon" FontFamily="{StaticResource Icons}" Text="&#xE823;"
                                   FontSize="12" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                                Background="{DynamicResource Track}" Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="Equalizer" Orientation="Horizontal" Height="14" Margin="0,0,2,0"
                                    Visibility="Collapsed">
                            <Rectangle x:Name="Bar1" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Eq}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar2" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Eq}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle x:Name="Bar3" Width="3" Height="14" Margin="1,0" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Eq}" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <!-- Bell: notifications you haven't looked at yet -->
                        <Grid x:Name="BellPanel" Margin="5,0,0,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" ToolTip="New notifications">
                            <Grid.RenderTransform><ScaleTransform x:Name="BellScale" /></Grid.RenderTransform>
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA8F;" FontSize="13" VerticalAlignment="Center" />
                            <Border x:Name="BellBadge" Background="#FFFF3B30" CornerRadius="6" MinWidth="12" Height="12" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
                                <TextBlock x:Name="BellCount" Foreground="White" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Ellipse x:Name="CamDot" Width="7" Height="7" Margin="4,0,0,0" Fill="#FF30D158" Visibility="Collapsed" ToolTip="Camera in use" />
                        <Ellipse x:Name="MicDot" Width="7" Height="7" Margin="4,0,0,0" Fill="#FFFF9F0A" Visibility="Collapsed" ToolTip="Microphone in use" />
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="4,0,0,0" Fill="#FFFF3B30" Visibility="Collapsed" ToolTip="Live / recording" />
                    </StackPanel>
                </Grid>

                <!-- ========== ACTIVITY (game launched, notification, voice...) ========== -->
                <Grid x:Name="ActivityView" Width="410" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,12,0,0" Visibility="Collapsed" Opacity="0" Background="Transparent"
                      Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActivityIconBg" Width="40" Height="40" CornerRadius="12"
                            Background="#FF0A84FF" VerticalAlignment="Top">
                        <TextBlock x:Name="ActivityIcon" Foreground="White" FontFamily="{StaticResource Icons}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="Top">
                        <TextBlock x:Name="ActivityTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ActivitySubtitle" FontSize="12" Foreground="{DynamicResource FgSoft}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50" />
                    </StackPanel>
                </Grid>

                <!-- ========== EXPANDED (on hover) ========== -->
                <Grid x:Name="ExpandedView" Width="656" Height="240" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Margin="0,12,0,0" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: time, date, live badges, weather -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BigTime" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="DateText" Style="{StaticResource Dim}" FontSize="12" Margin="10,0,0,4" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BellButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                                    Margin="0,0,10,0" Click="Bell_Click" ToolTip="Notifications">
                                <Grid>
                                    <TextBlock Text="&#xEA8F;" />
                                    <Border x:Name="HeaderBadge" Background="#FFFF3B30" CornerRadius="6" MinWidth="12" Height="12" Padding="3,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0" Visibility="Collapsed">
                                        <TextBlock x:Name="HeaderBadgeCount" Foreground="White" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border x:Name="LiveBadge" CornerRadius="5" Background="#FFFF3B30" Padding="7,2" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="● LIVE" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                            <Border x:Name="RecBadge" CornerRadius="5" Background="#33FF3B30" BorderBrush="#FFFF3B30" BorderThickness="1"
                                    Padding="7,1" Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock Text="● REC" FontSize="10.5" FontWeight="Bold" Foreground="#FFFF6961" />
                            </Border>
                            <Border x:Name="MicBadge" CornerRadius="5" Background="#33FF9F0A" Padding="7,2" Margin="0,0,10,0" Visibility="Collapsed">
                                <TextBlock x:Name="MicBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFB340" />
                            </Border>
                            <TextBlock x:Name="WeatherIcon" FontFamily="Segoe UI Symbol" FontSize="17" VerticalAlignment="Center" />
                            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherTemp" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="WeatherDesc" Style="{StaticResource Dim}" FontSize="10.5" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Notifications page (bell button) -->
                    <Grid x:Name="NotifPage" Grid.Row="1" Margin="0,12,0,4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Notifications" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button Style="{StaticResource IconButton}" Width="Auto" Height="26" Padding="10,0" DockPanel.Dock="Right"
                                    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" Click="ClearNotifs_Click">
                                <TextBlock Text="Clear all" Margin="10,0" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="Auto" Height="26" DockPanel.Dock="Right" Margin="0,0,8,0"
                                    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5" Click="Bell_Click">
                                <TextBlock Text="Back" Margin="10,0" />
                            </Button>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="NotifList" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Main: media on the left, system stats on the right -->
                    <Grid x:Name="MainPage" Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="236" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BigArt" Width="100" Height="100" CornerRadius="14" Background="{DynamicResource Track}" VerticalAlignment="Center">
                                <TextBlock x:Name="BigArtPlaceholder" FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="30"
                                           Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaSource" Style="{StaticResource Dim}" />
                                <TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtist" FontSize="12.5" Foreground="{DynamicResource FgSoft}" TextTrimming="CharacterEllipsis" />
                                <Grid x:Name="ProgressTrack" Height="4" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource Track}" CornerRadius="2" />
                                    <Border x:Name="MediaProgress" Background="{DynamicResource Fg}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <StackPanel x:Name="MediaButtons" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" />
                                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" Margin="8,0" Click="PlayPause_Click"
                                            Background="{DynamicResource ButtonHover}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- CPU -->
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                <Grid x:Name="CpuTrack" Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Track}" CornerRadius="3" />
                                    <Border x:Name="CpuBar" Background="#FF0A84FF" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="CpuText" Grid.Column="2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- RAM -->
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                <Grid x:Name="RamTrack" Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Track}" CornerRadius="3" />
                                    <Border x:Name="RamBar" Background="#FFBF5AF2" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="RamText" Grid.Column="2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- GPU -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GPU" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                <Grid x:Name="GpuTrack" Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Track}" CornerRadius="3" />
                                    <Border x:Name="GpuBar" Background="#FF30D158" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <TextBlock x:Name="GpuText" Grid.Column="2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Network -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetIcon" FontFamily="{StaticResource Icons}" Text="&#xE701;" FontSize="14"
                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="NetSpeed" FontSize="12" />
                                    <TextBlock x:Name="NetInfo" Style="{StaticResource Dim}" FontSize="10.5" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Shortcuts -->
                    <ItemsControl x:Name="ShortcutsBar" Grid.Row="2" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
